PORT=3001
# Alpha Vantage: a single key, or a comma-separated pool for automatic
# rotation when a key hits its 25/day free-tier limit (ALPHA_VANTAGE_API_KEYS
# takes precedence; ALPHA_VANTAGE_API_KEY is the single-key fallback).
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
# ALPHA_VANTAGE_API_KEYS=key_one,key_two,key_three

# Stocks Agent (GitHub Models or any OpenAI-compatible endpoint)
GITHUB_MODELS_TOKEN=your_github_pat_with_models_read
AGENT_MODEL=gpt-4o-mini
AGENT_BASE_URL=https://models.github.ai/inference

# Plaid Brokerage Integration
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox
PLAID_ENCRYPTION_KEY=your_64_char_hex_key_for_aes256

# Encrypted backups — npm run backup / npm run restore (see README "Data Backup")
# Keep BACKUP_PASSPHRASE in a password manager: backups cannot be restored without it.
BACKUP_PASSPHRASE=
# Private GitHub repo that receives backups as Release assets (uses the gh CLI)
BACKUP_GITHUB_REPO=
# gh account to upload with (optional; defaults to the active gh account)
BACKUP_GITHUB_USER=
# BACKUP_GITHUB_TOKEN=            # alternative to gh login: a PAT with repo scope
# BACKUP_DIR=                     # default: ~/PersonalHub-backups
# BACKUP_KEEP_LOCAL=14
# BACKUP_KEEP_REMOTE=30
# BACKUP_INTERVAL_HOURS=24
# BACKUP_AUTO=true